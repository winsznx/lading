# Lading API: FastAPI + HiGHS. Results are baked in from the committed results/ files and served read-only.
FROM python:3.11.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LADING_RESULTS_DIR=/app/results

WORKDIR /app
COPY deploy/requirements.txt /tmp/requirements.txt
RUN pip install --require-hashes -r /tmp/requirements.txt

COPY api/ api/
COPY baselines/ baselines/
COPY explain/ explain/
COPY planner/ planner/
COPY scenarios/ scenarios/
COPY sim/ sim/
COPY validate/ validate/
COPY schemas/ schemas/
COPY results/ results/
COPY data/ data/
COPY cost_model.py errors.py plan_assembly.py plan_model.py world.py ./

ARG LADING_COMMIT=unknown
ENV LADING_COMMIT=${LADING_COMMIT}

RUN useradd --system --uid 10001 --no-create-home lading \
    && find /app -name 'test_*.py' -delete \
    && chmod -R a-w /app
USER lading

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=6s --start-period=15s --retries=3 \
    CMD python -c "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5).status == 200 else 1)"

CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "3", "--no-server-header"]
